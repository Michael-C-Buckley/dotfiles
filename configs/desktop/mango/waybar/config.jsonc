
{
"modules-left": [
    "ext/workspaces",
    // "dwl/tags",
    "dwl/window",
    "cpu",
    "memory",
],
  "modules-center": ["mpris"],
  "modules-right": [
    "tray",
    "custom/sep",
    "bluetooth",
    "pulseaudio",
    "custom/swaync",
    "custom/sep",
    "clock",
    "clock#simpleclock",
    "custom/sep",
    "battery",
    "custom/power",
  ],
  "mpris": {
    "dynamic-order": ["artist","title"],
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "status-icons": {
      "paused": "",
    },
    "player-icons": {
      "default": "",
    },
  },
  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": false,
    "on-click": "activate",
    "sort-by-id": true,
  },
  "dwl/tags": {
      "num-tags":9,
  },
  "dwl/window": {
      "format": "[{layout}]"
  },
  "tray": {
    "show-passive-items": true,
    "spacing": 10,
  },
  "clock#simpleclock": {
    "tooltip": false,
    "format": " {:%H:%M}",
  },
  "clock": {
    "format": " {:%d %b}",
      "tooltip": false,
      "mode": "month",
      "mode-mon-col": 1,
      "on-scroll": 1,
    },
"battery": {
	"interval": 60,
	"states": {
		"warning": 30,
		"critical": 15
	},
	"events": {
		"on-discharging-warning": "notify-send -u normal 'Low Battery: 30%'",
		"on-discharging-critical": "notify-send -u critical 'Critical Battery: 15%'",
		"on-charging-100": "notify-send -u normal 'Battery Full'"
	},
	"format": "{capacity}% {icon}",
	"format-icons": ["", "", "", "", ""],
	"max-length": 25
},
 "cpu": {
    "format": " {usage}%",
    "tooltip": true,
    "interval": 1,
  },
  "memory": {
    "format": "  {used:0.1f}Gi",
  },
  "pulseaudio": {
    "format": "{icon}{volume}%",
    "format-muted": " muted",
    "format-icons": {
      "headphone": "",
      "default": [" ", " ", " "],
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
  },
  "custom/sep": {
    "format": "|",
    "tooltip": false,
  },
  "custom/power": {
    "tooltip": false,
    "on-click": "wleave",
    "format": "⏻",
  },
  "custom/swaync": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "󰂛"
    },
  "return-type": "json",
  "exec": "swaync-client -swb",
  "on-click": "swaync-client -t -sw",
  "escape": true
  },
  "bluetooth": {
	  "format": " {status}",
	  "format-connected": " {device_alias}",
	  "format-connected-battery": " {device_alias} {device_battery_percentage}%",
	  // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
	  "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
	  "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
	  "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	  "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },
}
