	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#888888"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"string.quoted",
				"punctuation.definition.string",
				"constant.other.symbol"
			],
			"settings": {
				"foreground": "#F6C177"
			}
		},
		{
			"name": "TODO and FIXME markers",
			"scope": [
				"keyword.other.todo",
				"keyword.other.fixme",
				"markup.changed",
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#EB6F92"
			}
		},
		{
			"name": "Headings and links",
			"scope": [
				"entity.name.section",
				"markup.heading",
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#F6C177"
			}
		},
		{
			"name": "Everything else stays Zen",
			"scope": [
				"variable",
				"constant",
				"entity",
				"keyword",
				"storage",
				"support",
				"meta",
				"punctuation"
			],
			"settings": {
				"foreground": "#DFE0DC"
			}
		}
	],
	"semanticTokenColors": {
		"*": "#DFE0DC",
		"comment": "#888888",
		"string": "#F6C177"
	}
}
